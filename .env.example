# ========================================================
# RAGHire — Placement Preparation Platform Environment Config
# Tagline: Prepare. Practise. Improve. Get Placement-Ready.
# MCA Major Project Configuration
# ========================================================

# Application Core
PROJECT_NAME="RAGHire"
PROJECT_VERSION="1.0.0"
SECRET_KEY="raghire-super-secret-jwt-key-2026-mca-project"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Defaults to SQLite with built-in vector similarity for zero-setup execution:
DATABASE_URL="sqlite:///./raghire.db"
# Or configure PostgreSQL with pgvector for Docker deployment:
# DATABASE_URL="postgresql://raghire_user:raghire_password_2026@localhost:5432/raghire_db"

# Uploads Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# AI & LLM Provider Configuration
# Options: "mock" (High-fidelity demo mode), "gemini", "openai", "ollama"
AI_PROVIDER="mock"
DEMO_MODE="true"

# Google Gemini API Key (Optional)
GEMINI_API_KEY=""

# OpenAI API Key (Optional)
OPENAI_API_KEY=""

# Ollama Base URL (Local model)
OLLAMA_BASE_URL="http://localhost:11434"

# Judge0 Sandboxed Code Execution Service (Optional)
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
